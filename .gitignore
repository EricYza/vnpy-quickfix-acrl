QuickFIX/bin/executor
QuickFIX/bin/tradeclient

# Local vn.py/FIX runtime state
**/.vntrader/
vnpy_quickfix_gateway/runtime/
vnpy_acrl_execution/runtime/

# RL training output that is not required by the deployed policy
rlte/runs/
rlte/runs_*/
